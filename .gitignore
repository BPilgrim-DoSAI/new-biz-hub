# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
firebase-debug.log*
firebase-debug.*.log*

# Firebase cache
.firebase/

# Firebase config

# Uncomment this if you'd like others to create their own Firebase project.
# For a team working on the same Firebase project(s), it is recommended to leave
# it commented so all members can deploy to the same project(s) in .firebaserc.
# .firebaserc

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage

# nyc test coverage
.nyc_output

# Grunt intermediate storage (http://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (http://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables file
.env

# dataconnect generated files
.dataconnect

# Local emulator state (Firestore + Auth test data — local-only)
emulator-data/

# Build output — generated by `npm run build` (esbuild compiles JSX to JS).
# Committing the compiled output would invite drift between source and build.
js/dist/

# Local Claude Code session artifacts — workspace state, not project content.
.agents/
skills-lock.json

# Service account keys — never commit (full project access)
*-firebase-adminsdk-*.json
service-account*.json

# Firestore backups (contain licence/staff data) — keep out of git
firestore-*-backup-*.json

# Claude usage exports + processed sample data (real conversation titles,
# prompts and client names). The product serves this from Firestore behind
# agency-admin auth; it must never live in the repo. Includes the local
# preview's sample-data. A synthetic fixture can be committed separately.
scripts/usage/sample-data/
scripts/usage/**/digest.json
scripts/usage/**/metrics.json
scripts/usage/**/dashboard_data.json
scripts/usage/**/classification.json
# Local real-data preview built from a real export (synthetic usage-preview.html is committed).
usage-preview.local.html
usage-preview*.local.html

# macOS system files
.DS_Store

# E2E test screenshots (generated by scripts/local-e2e.mjs)
test-screenshots/

# Claude Code local config (keep commands/ for shared skills)
.claude/*
!.claude/commands/
